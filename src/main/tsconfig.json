{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "rootDir": "..",
    "outDir": "../../lib/main",
    "lib": ["ES2025"],
    "types": ["node"],
    "moduleResolution": "nodenext",
    "module": "nodenext"
  },
  "include": [
    "./**/*.ts",
    "../shared/**/*.ts",
    "../domain/**/*.ts",
    "../application/**/*.ts",
    "../infrastructure/**/*.ts"
  ],
  "exclude": ["**/*.test.ts", "**/*.spec.ts"]
}
